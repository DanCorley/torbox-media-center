TORBOX_API_KEY=
MOUNT_METHOD=strm
MOUNT_PATH=/torbox
ENABLE_METADATA=false
MOUNT_REFRESH_TIME=slow
RAW_MODE=false

# Control API used by the Jellyfin plugin. Set CONTROL_ENABLED=true to start it.
# In Docker use 0.0.0.0 so other containers can reach it; on bare metal use 127.0.0.1.
CONTROL_ENABLED=false
CONTROL_HOST=0.0.0.0
CONTROL_PORT=8787
CONTROL_TOKEN=
CONTROL_MIN_INTERVAL=60
